{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruvora:threadport:0.1.0:manifest",
  "title": "manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "threadport.package/1.0.0"
    },
    "packageId": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "producerVersion": {
      "const": "0.1.0"
    },
    "codexVersion": {
      "const": "not-native"
    },
    "historyFormat": {
      "const": "threadport.synthetic-source/1.0.0"
    },
    "sourceSchemaDigest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapterId": {
      "const": "synthetic-v1"
    },
    "adapterVersion": {
      "const": "1.0.0"
    },
    "boundary": {
      "type": "object",
      "properties": {
        "sourceAlias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "turnAlias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "inclusive": {
          "const": true
        },
        "terminalStatus": {
          "const": "completed"
        },
        "prefixDigest": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "sourceAlias",
        "turnAlias",
        "inclusive",
        "terminalStatus",
        "prefixDigest"
      ],
      "additionalProperties": false
    },
    "fidelity": {
      "const": "exact_stored_history"
    },
    "historyDigest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 128
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "mediaType": {
            "enum": [
              "application/json",
              "application/x-ndjson"
            ]
          },
          "purpose": {
            "enum": [
              "history_index",
              "history_records",
              "environment",
              "provenance"
            ]
          }
        },
        "required": [
          "path",
          "byteLength",
          "sha256",
          "mediaType",
          "purpose"
        ],
        "additionalProperties": false
      },
      "maxItems": 4
    },
    "transforms": {
      "type": "array",
      "items": {},
      "maxItems": 0
    },
    "requirements": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "maxItems": 0
        },
        "workspaceIncluded": {
          "const": false
        },
        "credentialsIncluded": {
          "const": false
        },
        "executionGranted": {
          "const": false
        }
      },
      "required": [
        "capabilities",
        "workspaceIncluded",
        "credentialsIncluded",
        "executionGranted"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "producerVersion",
    "codexVersion",
    "historyFormat",
    "sourceSchemaDigest",
    "adapterId",
    "adapterVersion",
    "boundary",
    "fidelity",
    "historyDigest",
    "files",
    "transforms",
    "requirements"
  ],
  "additionalProperties": false
}
