{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruvora:threadport:0.1.0:fixture_approval",
  "title": "fixture_approval",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "threadport.fixture-operation/0.1.0"
    },
    "approvalId": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "planDigest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "planId": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "const": 1
    },
    "action": {
      "enum": [
        "fixture_export",
        "fixture_import"
      ]
    },
    "target": {
      "const": "fixture-local"
    },
    "rootBinding": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "approvedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "authTag": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "approvalId",
    "planDigest",
    "planId",
    "revision",
    "action",
    "target",
    "rootBinding",
    "approvedAt",
    "expiresAt",
    "authTag"
  ],
  "additionalProperties": false
}
