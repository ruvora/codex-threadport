{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruvora:threadport:0.1.0:environment",
  "title": "environment",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "threadport.package/1.0.0"
    },
    "requestedCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "maxItems": 0
    },
    "pathAliases": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "maxItems": 0
    },
    "instructions": {
      "type": "array",
      "items": {},
      "maxItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "requestedCapabilities",
    "pathAliases",
    "instructions"
  ],
  "additionalProperties": false
}
